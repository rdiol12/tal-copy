<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="4dp" android:background="@drawable/widget_background_dark" android:layoutDirection="locale">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="18dp" android:gravity="center_vertical" android:text="@string/app_name" android:textColor="#ADC7FF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_open" android:layout_width="wrap_content" android:layout_height="36dp" android:paddingHorizontal="8dp" android:gravity="center" android:text="@string/widget_open" android:textColor="#ADC7FF" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_inactive" android:textColor="#E7EDF4" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    <Chronometer android:id="@+id/widget_elapsed" android:textDirection="ltr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#E7EDF4" android:textSize="20sp" android:textStyle="bold" android:visibility="gone" android:format="%s" android:minHeight="20dp" android:includeFontPadding="false" />
    <TextView android:id="@+id/widget_idle" android:textDirection="ltr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="00:00" android:textColor="#E7EDF4" android:textSize="20sp" android:textStyle="bold" android:minHeight="20dp" android:includeFontPadding="false" />
    <LinearLayout android:id="@+id/widget_start_group" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/widget_start_office" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/widget_start_office" android:textSize="11sp" android:textAllCaps="false" android:backgroundTint="#ADC7FF" android:textColor="#002D73" android:paddingHorizontal="2dp" android:paddingVertical="0dp" android:minWidth="0dp" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
        <Button android:id="@+id/widget_start_home" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/widget_start_home" android:textSize="11sp" android:textAllCaps="false" android:backgroundTint="#80D6CB" android:textColor="#003733" android:paddingHorizontal="2dp" android:paddingVertical="0dp" android:minWidth="0dp" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <Button android:id="@+id/widget_stop" android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone" android:text="@string/widget_stop" android:textSize="11sp" android:textAllCaps="false" android:backgroundTint="#FFB1C0" android:textColor="#650D25" android:paddingHorizontal="2dp" android:paddingVertical="0dp" android:minWidth="0dp" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
</LinearLayout>
