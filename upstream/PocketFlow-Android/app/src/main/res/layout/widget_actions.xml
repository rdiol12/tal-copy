<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background">
    <FrameLayout android:id="@+id/widget_page_action" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginTop="32dp" android:layout_marginBottom="32dp" android:clipChildren="true" android:clipToPadding="true">
        <ViewFlipper android:id="@+id/widget_flip_up" android:layout_width="match_parent" android:layout_height="match_parent"
            android:animateFirstView="true" android:autoStart="false" android:inAnimation="@anim/widget_up_in" android:outAnimation="@anim/widget_up_out"
            android:clipChildren="true" android:clipToPadding="true">
            <include layout="@layout/widget_content_account" />
            <include layout="@layout/widget_content_movement" />
            <include layout="@layout/widget_content_rule" />
        </ViewFlipper>
        <ViewFlipper android:id="@+id/widget_flip_down" android:layout_width="match_parent" android:layout_height="match_parent"
            android:animateFirstView="true" android:autoStart="false" android:inAnimation="@anim/widget_down_in" android:outAnimation="@anim/widget_down_out"
            android:clipChildren="true" android:clipToPadding="true" android:visibility="gone">
            <include layout="@layout/widget_content_account" />
            <include layout="@layout/widget_content_movement" />
            <include layout="@layout/widget_content_rule" />
        </ViewFlipper>
    </FrameLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="32dp" android:layout_gravity="top|left"
        android:paddingLeft="6dp" android:text="PocketFlow" android:gravity="center" android:textSize="8sp" android:textColor="#DCE7FF" />
    <TextView android:id="@+id/widget_up" android:layout_width="64dp" android:layout_height="32dp" android:layout_gravity="top|center_horizontal"
        android:text="▲" android:gravity="center" android:textSize="18sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:contentDescription="@string/widget_up" />
    <TextView android:id="@+id/widget_down" android:layout_width="64dp" android:layout_height="32dp" android:layout_gravity="bottom|center_horizontal"
        android:text="▼" android:gravity="center" android:textSize="18sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:contentDescription="@string/widget_down" />
    <TextView android:id="@+id/widget_page_indicator" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_gravity="bottom|right"
        android:paddingRight="10dp" android:text="2 / 3" android:gravity="center" android:textSize="10sp" android:textColor="#DCE7FF" />
</FrameLayout>
