<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_add_action" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="4dp"
    android:background="@drawable/widget_background" android:contentDescription="@string/widget_add_label">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:text="+" android:textSize="22sp" android:textColor="#FFFFFF" android:includeFontPadding="false" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:text="@string/widget_add_text" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFFFFF"
        android:maxLines="2" android:includeFontPadding="false" android:textDirection="rtl" />
</LinearLayout>
